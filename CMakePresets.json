{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KINETALIS_ENABLE_PCH": "ON"
      }
    },
    {
      "name": "ubuntu",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/gcc-14",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-14"
      }
    },
    {
      "name": "tuhh-hpc",
      "hidden": true,
      "inherits": "base",
      "environment": {
        "GCC_ROOT": "/nfs/rzpool/gcc/gcc-14.2.0",
        "PATH": "$env{GCC_ROOT}/bin:$penv{PATH}",
        "LD_LIBRARY_PATH": "$env{GCC_ROOT}/lib64:$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{GCC_ROOT}/bin/gcc",
        "CMAKE_CXX_COMPILER": "$env{GCC_ROOT}/bin/g++"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "batch-base",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KINETALIS_BUILD_BATCH": "ON",
        "KINETALIS_BUILD_VIEWER": "OFF",
        "KINETALIS_BUILD_TESTS": "OFF"
      },
      "hidden": true
    },
    {
      "name": "tests-base",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KINETALIS_BUILD_BATCH": "OFF",
        "KINETALIS_BUILD_VIEWER": "OFF",
        "KINETALIS_BUILD_TESTS": "ON",
        "KINETALIS_ENABLE_CLANG_TIDY": "OFF"
      },
      "hidden": true
    },
    {
      "name": "windows-batch-release",
      "displayName": "Windows | Batch | Release",
      "inherits": "batch-base"
    },
    {
      "name": "windows-viewer-release",
      "displayName": "Windows | Viewer | Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KINETALIS_BUILD_BATCH": "OFF",
        "KINETALIS_BUILD_VIEWER": "ON",
        "KINETALIS_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-viewer-debug",
      "displayName": "Windows | Viewer | Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KINETALIS_BUILD_BATCH": "OFF",
        "KINETALIS_BUILD_VIEWER": "ON",
        "KINETALIS_BUILD_TESTS": "OFF",
        "KINETALIS_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "windows-tests-debug",
      "displayName": "Windows | Tests | Debug",
      "inherits": "tests-base"
    },
    {
      "name": "windows-tests-analysis",
      "displayName": "Windows | Tests | Analysis",
      "inherits": "windows-tests-debug",
      "cacheVariables": {
        "KINETALIS_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "windows-tests-no-pch",
      "displayName": "Windows | Tests | No PCH",
      "inherits": "windows-tests-debug",
      "cacheVariables": {
        "KINETALIS_ENABLE_PCH": "OFF"
      }
    },
    {
      "name": "windows-benchmark-release",
      "displayName": "Windows | Benchmark | Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KINETALIS_BUILD_BENCHMARKS": "ON",
        "KINETALIS_BUILD_BATCH": "OFF",
        "KINETALIS_BUILD_TESTS": "OFF",
        "KINETALIS_BUILD_VIEWER": "OFF",
        "KINETALIS_ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "ubuntu-batch-release",
      "displayName": "Ubuntu | Batch | Release",
      "inherits": [
        "batch-base",
        "ubuntu"
      ]
    },
    {
      "name": "ubuntu-tests-debug",
      "displayName": "Ubuntu | Tests | Debug",
      "inherits": [
        "tests-base",
        "ubuntu"
      ]
    },
    {
      "name": "tuhh-hpc-batch-release",
      "displayName": "TUHH HPC | Batch | Release",
      "inherits": [
        "batch-base",
        "tuhh-hpc"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "build-windows-batch-release",
      "displayName": "Windows | Batch | Release",
      "configurePreset": "windows-batch-release",
      "targets": [
        "kinetalis_batch"
      ]
    },
    {
      "name": "build-windows-viewer-release",
      "displayName": "Windows | Viewer | Release",
      "configurePreset": "windows-viewer-release",
      "targets": [
        "kinetalis_viewer"
      ]
    },
    {
      "name": "build-windows-viewer-debug",
      "displayName": "Windows | Viewer | Debug",
      "configurePreset": "windows-viewer-debug",
      "targets": [
        "kinetalis_viewer"
      ]
    },
    {
      "name": "build-windows-tests-debug",
      "displayName": "Windows | Tests | Debug",
      "configurePreset": "windows-tests-debug",
      "targets": [
        "kinetalis_tests"
      ]
    },
    {
      "name": "build-windows-tests-analysis",
      "displayName": "Windows | Tests | Analysis",
      "configurePreset": "windows-tests-analysis",
      "targets": [
        "kinetalis_tests"
      ]
    },
    {
      "name": "build-windows-tests-no-pch",
      "displayName": "Windows | Tests | No PCH",
      "configurePreset": "windows-tests-no-pch",
      "targets": [
        "kinetalis_tests"
      ]
    },
    {
      "name": "build-windows-benchmark-release",
      "displayName": "Windows | Benchmark | Release",
      "configurePreset": "windows-benchmark-release",
      "targets": [
        "kinetalis_benchmarks"
      ]
    },
    {
      "name": "build-ubuntu-batch-release",
      "displayName": "Ubuntu | Batch | Release",
      "configurePreset": "ubuntu-batch-release",
      "targets": [
        "kinetalis_batch"
      ]
    },
    {
      "name": "build-ubuntu-tests-debug",
      "displayName": "Ubuntu | Tests | Debug",
      "configurePreset": "ubuntu-tests-debug",
      "targets": [
        "kinetalis_tests"
      ]
    },
    {
      "name": "build-tuhh-hpc-batch-release",
      "displayName": "TUHH HPC | Batch | Release",
      "configurePreset": "tuhh-hpc-batch-release",
      "targets": [
        "kinetalis_batch"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test-windows-tests-debug",
      "displayName": "Windows | Tests | Debug",
      "configurePreset": "windows-tests-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-windows-tests-analysis",
      "displayName": "Windows | Tests | Analysis",
      "configurePreset": "windows-tests-analysis",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-windows-tests-no-pch",
      "displayName": "Windows | Tests | No PCH",
      "configurePreset": "windows-tests-no-pch",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-ubuntu-tests-debug",
      "displayName": "Ubuntu | Tests | Debug",
      "configurePreset": "ubuntu-tests-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
